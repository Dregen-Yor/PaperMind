{
  "name": "papermind",
  "productName": "PaperMind",
  "version": "0.1.0",
  "description": "",
  "main": "dist-electron/main.js",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "npm": ">=10.0.0 <11"
  },
  "scripts": {
    "dev": "node scripts/ensure-electron.mjs && node scripts/dev.mjs",
    "build": "vue-tsc --noEmit && vite build && electron-builder",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && npm run test:branding",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:branding": "node --test scripts/tests/icon-assets.test.mjs scripts/tests/dev-branding.test.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "bench": "tsx bench/src/cli.ts",
    "bench:trees": "tsx bench/src/treeInspectCli.ts",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@huggingface/transformers": "^3.8.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/ui": "^4.1.8",
    "@vue/test-utils": "^2.4.11",
    "electron": "^44.2.0",
    "electron-builder": "^24.0.0",
    "jsdom": "^29.1.1",
    "sharp": "0.34.5",
    "tsx": "^4.23.13",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.0.0"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.12",
    "element-plus": "^2.14.1",
    "katex": "^0.18.1",
    "markdown-it": "^14.3.0",
    "markdown-it-texmath": "^1.0.0",
    "pdfjs-dist": "^6.0.227",
    "pinia": "^3.0.4",
    "vue": "^3.5.35",
    "vue-router": "^4.6.4"
  },
  "build": {
    "appId": "com.papermind.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/papermind-icon.png"
    },
    "win": {
      "target": "nsis"
    }
  }
}
