{
  "name": "papermind",
  "productName": "PaperMind",
  "version": "0.1.0",
  "description": "",
  "main": "dist-electron/main.js",
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": "24.22.1",
    "npm": "10.9.4"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:source && electron-builder",
    "build:source": "npm run icons:check && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run && npm run test:branding && npm run test:architecture",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:branding": "node --test scripts/tests/icon-assets.test.mjs scripts/tests/dev-branding.test.mjs scripts/tests/linux-install.test.mjs scripts/tests/runtime-security.test.mjs",
    "test:architecture": "node --test scripts/tests/docling-production-config.test.mjs scripts/tests/ci-workflow.test.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "icons:check": "node scripts/check-icons.mjs",
    "bench": "tsx bench/src/cli.ts",
    "bench:product": "tsx bench/src/productCli.ts",
    "bench:trees": "tsx bench/src/treeInspectCli.ts",
    "verify:toolchain": "node scripts/verify-toolchain.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:native": "node scripts/verify-native.mjs",
    "verify:install": "npm run verify:toolchain && npm run verify:manifest && npm run verify:native",
    "prepare:install": "node scripts/prepare-install.mjs",
    "postinstall": "node scripts/prepare-install.mjs",
    "security:node": "node scripts/verify-toolchain.mjs",
    "security:runtime": "node scripts/check-runtime.mjs --electron",
    "security:test": "node --test scripts/tests/runtime-security.test.mjs",
    "preinstall": "node scripts/verify-toolchain.mjs",
    "predev": "npm run verify:install",
    "prebuild": "npm run verify:install",
    "pretest": "npm run verify:toolchain",
    "pretypecheck": "npm run verify:toolchain",
    "prepreview": "npm run verify:toolchain",
    "pretest:watch": "npm run verify:toolchain",
    "pretest:ui": "npm run verify:toolchain",
    "prebench": "npm run verify:toolchain",
    "prebench:product": "npm run verify:toolchain",
    "prebench:trees": "npm run verify:toolchain"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/markdown-it": "14.1.2",
    "@types/node": "26.4.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitest/ui": "4.1.8",
    "@vue/test-utils": "2.4.11",
    "electron": "44.11.3",
    "electron-builder": "24.13.3",
    "jsdom": "29.1.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.7",
    "vitest": "4.1.8",
    "vue-tsc": "2.2.12"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@huggingface/transformers": "3.8.1",
    "better-sqlite3": "13.0.3",
    "dompurify": "3.4.12",
    "element-plus": "2.14.1",
    "katex": "0.18.1",
    "markdown-it": "14.3.0",
    "markdown-it-texmath": "1.0.0",
    "parse5": "8.0.1",
    "pdfjs-dist": "6.0.227",
    "pinia": "3.0.4",
    "vue": "3.5.35",
    "vue-router": "4.6.4",
    "sharp": "0.34.5"
  },
  "build": {
    "appId": "com.papermind.app",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "assets/icons",
        "to": "icons",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/linux",
      "executableName": "com.papermind.app",
      "desktop": {
        "StartupWMClass": "com.papermind.app"
      }
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/mac.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icons/win.ico"
    },
    "afterPack": "scripts/check-packaged-runtime.cjs"
  }
}
